# Сервер дээр: /var/www/huyagtan.mn/.env  (git-д орохгүй). deploy/setup-db.sh эхний гурвыг автоматаар үүсгэнэ.
DATABASE_URL=postgres://huyagtan:НУУЦ_ҮГ@127.0.0.1:5432/huyagtan
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_URL=https://huyagtan.mn

# Супер админ (P1.3): энэ имэйлээр анх нэвтэрсэн хүн супер админ болно.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=""                 # "Эцгийн-нэр Өөрийн-нэр" — импортын мөртэй нэрээр тулгагдана

# Имэйл (magic link, мэдэгдэл). Resend: smtps://resend:API_KEY@smtp.resend.com:465
EMAIL_SERVER=
EMAIL_FROM="Хуягтан <no-reply@huyagtan.mn>"

# Google-ээр нэвтрэх (заавал биш). Redirect URI: https://huyagtan.mn/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

NODE_OPTIONS=--max-old-space-size=384
