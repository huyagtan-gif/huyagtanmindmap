# Сервер дээр: /var/www/huyagtan.mn/.env  (git-д орохгүй). deploy/setup-db.sh эхний гурвыг автоматаар үүсгэнэ.
DATABASE_URL=postgres://huyagtan:НУУЦ_ҮГ@127.0.0.1:5432/huyagtan
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_URL=https://huyagtan.mn

# Супер админ (P1.3): энэ имэйлээр анх нэвтэрсэн хүн супер админ болно.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=""                 # "Эцгийн-нэр Өөрийн-нэр" — импортын мөртэй нэрээр тулгагдана

# Имэйл (magic link, мэдэгдэл). Resend: smtps://resend:API_KEY@smtp.resend.com:465
EMAIL_SERVER=
EMAIL_FROM="Хуягтан <no-reply@huyagtan.mn>"

# Google-ээр нэвтрэх (заавал биш). Redirect URI: https://huyagtan.mn/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

NODE_OPTIONS=--max-old-space-size=384

# --- Phase 2 ---
# SMS гарц (P2.3). Тохируулаагүй бол SMS-ээр баталгаажуулах / нэвтрэх хэсэг харагдахгүй.
# URL болон биеийн загварт {to} {text} {from} орлуулагдана. Гарцынхаа API баримтаас авна.
SMS_HTTP_URL=                     # жишээ: https://sms.example.mn/send?from={from}&to={to}&text={text}
SMS_HTTP_METHOD=GET               # GET | POST
SMS_HTTP_HEADERS=                 # JSON, жишээ: {"x-api-key":"..."}
SMS_HTTP_BODY=                    # POST үед, жишээ: {"to":"{to}","text":"{text}","from":"{from}"}
SMS_FROM=
SMS_TO_FORMAT=local               # local = 8 оронтой, e164 = +976...

# Captcha (N6): Cloudflare Turnstile. Хоёуланг нь тохируулсан үед нэвтрэх / бүртгүүлэх хуудсанд гарна.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Алдааны хяналт (P2.9): шинэ алдаанд супер админд имэйл явуулна. Унтраах бол off.
ERROR_ALERTS=
# Туршилтын орчинд staging гэж тавина (deploy/setup-staging.sh автоматаар бичнэ).
APP_ENV=

# --- Phase 4: төлбөр ---
# QPay merchant-ийн нэвтрэх нэр, нууц үг, нэхэмжлэхийн кодыг өргөө бүр «Санхүү → QPay тохиргоо»-д оруулна (DB-д шифрлэгдэнэ).
# Шифрлэх түлхүүр. Тохируулаагүй бол AUTH_SECRET ашиглана. Нэг удаа тавиад ДАХИН СОЛИХГҮЙ (солибол хадгалсан нууц үг тайлагдахгүй).
PAYMENT_SECRET=                   # openssl rand -base64 32
# Туршилт: жинхэнэ QPay-гүйгээр mock төлбөр (зөвхөн staging/local, production-д ажиллахгүй).
QPAY_MOCK=

# --- Phase 5: push мэдэгдэл ---
# `node scripts/vapid.mjs`-ээр үүсгэнэ. Тохируулаагүй бол push унтраалттай (имэйл мэдэгдэл хэвээр).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                    # https://huyagtan.mn эсвэл mailto:...  (анхдагч: AUTH_URL)
